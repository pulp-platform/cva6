# ASIC implementation of CVA6: the design side. Run it as `make -C asic <target>`:
#   deps            the sources the flow reads: submodules and Bender dependencies
#   sram-inventory  the SRAMs of the selected configuration
#   synth           synthesis (synth-elab: up to its checks; synth-analyze: its file list)
#   pnr             place and route
#   spef            parasitics of a completed place-and-route run
# The technology flows are not open. Each lives in a repository of its own,
# cloned into asic/<tech> at the commit pinned in its section below
# (`make -C asic <tech>-init`); this file includes its <tech>.mk, which runs the
# stages. ASIC_TECH selects the technology.

ASIC_DIR             := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
ASIC_TECH            ?= gf22
ASIC_CONSTRAINTS_DIR := $(ASIC_DIR)/constraints
ASIC_BUILD           ?= $(ASIC_DIR)/build

# The design: the cva6 tree every Bender and RTL command reads, and its
# configuration
#   CVA6_CONFIG       a configuration, as a Bender target of cva6
#   CVA6_CONFIG_PKG   a configuration package that replaces that configuration's
#                     own, such as a variant generated by test/util/sweep.py
CVA6_ROOT        ?= $(abspath $(ASIC_DIR)/..)
CVA6_CONFIG      ?= cv64a6_imafdchxhclic_sv39_hpdcache_wb
CVA6_CONFIG_PKG  ?=
BENDER           ?= bender
BENDER_DEFINES   ?=
BENDER_TARGETS   ?= -t $(CVA6_CONFIG) -t rtl -t cva6 -t asic -t cva6_asic
TOP_DESIGN       ?= synth_top

# The clock period [ps]: the period the design is implemented at, and the
# default of both stages' periods. Synthesis over-constrains it, with a margin
# or with a period of its own:
#   SYNTH_CLK_PERIOD  the period synthesis evaluates the constraints at
#   SYNTH_MARGIN      extra setup uncertainty in synthesis, a fraction of the
#                     period (constraints/cva6.sdc); the netlist, the written
#                     constraints and the reports are at the period itself
# A synthesis period given explicitly is the over-constraint itself, so the
# margin then defaults to 0; otherwise it defaults to SYNTH_MARGIN_DEFAULT. A
# margin given explicitly always applies:
#   given                            synthesis period   margin
#   nothing, or CLK_PERIOD           CLK_PERIOD         SYNTH_MARGIN_DEFAULT
#   SYNTH_CLK_PERIOD                 as given           0
#   SYNTH_MARGIN                     CLK_PERIOD         as given
#   SYNTH_CLK_PERIOD and SYNTH_MARGIN as given          as given (a warning)
# `make synth` prints the values and their sources and records them in
# $(SYNTH_RUN_DIR)/params.json.
CLK_PERIOD           ?= 1000
SYNTH_MARGIN_DEFAULT ?= 0.17
ifeq ($(origin SYNTH_CLK_PERIOD),undefined)
SYNTH_CLK_PERIOD     := $(CLK_PERIOD)
SYNTH_CLK_PERIOD_SRC := CLK_PERIOD
synth_margin_default := $(SYNTH_MARGIN_DEFAULT)
synth_margin_src     := default
else
SYNTH_CLK_PERIOD_SRC := given
synth_clk_period_given := 1
synth_margin_default := 0
synth_margin_src     := synthesis period given
endif
ifeq ($(origin SYNTH_MARGIN),undefined)
SYNTH_MARGIN         := $(synth_margin_default)
SYNTH_MARGIN_SRC     := $(synth_margin_src)
else
SYNTH_MARGIN_SRC     := given
synth_margin_given   := 1
endif
# The period the netlist is for: CLK_PERIOD when given, else the synthesis
# period
ifneq ($(filter command line environment override,$(origin CLK_PERIOD)),)
SYNTH_TARGET_PERIOD  := $(CLK_PERIOD)
else
SYNTH_TARGET_PERIOD  := $(SYNTH_CLK_PERIOD)
endif

# Synthesis knobs
SYNTH_THREADS        ?= 8
# The hierarchy synthesis keeps:
#   flat    synthesis ungroups freely (default)
#   blocks  the main blocks of CVA6 stay hierarchies, so that area and power
#           can be reported per block; inside each block it ungroups as usual
#   rtl     the whole RTL hierarchy; costs some cross-boundary optimisation
SYNTH_HIERARCHY      ?= flat
# 1 keeps the scoreboard's entries off the automatic clock gates. A clock
# gate's enable must arrive earlier than a flip-flop's input; with
# NrLoadPipeRegs = 0 the load writeback reaches those enables late. Off by
# default, since it changes the result for every configuration.
SYNTH_SB_NO_CG       ?= 0
# 1 also reports the synthesized netlist at more corners; 0 skips them
SYNTH_CORNER_REPORTS ?= 1
# synth, or elab: read, link, constrain and check, then stop before
# compiling (`make synth-elab`)
SYNTH_STAGE          ?= synth
# Where a synthesis run writes: its reports, logs and netlists. Point it
# outside the checkout and several runs can share one clone.
SYNTH_RUN_DIR        ?= $(ASIC_BUILD)/synth

# Place-and-route knobs
TIMESTAMP      ?= today
PNR_NETLIST    ?= $(SYNTH_RUN_DIR)/netlists/$(TOP_DESIGN).v
PNR_FLOORPLAN  ?= 1_horizontal
PNR_THREADS    ?= max
# The place-and-route period [ps]: PNR_CLK_PERIOD, else CLK_PERIOD when given,
# else the period the netlist was synthesized for (params.json beside its
# netlists/), else CLK_PERIOD's default. `make pnr` prints it and its source
# and records both in $(PNR_RUN_DIR)/params.json.
PNR_NETLIST_PARAMS := $(abspath $(dir $(PNR_NETLIST))../params.json)
ifneq ($(origin PNR_CLK_PERIOD),undefined)
PNR_CLK_PERIOD_SRC := given
else ifneq ($(filter command line environment override,$(origin CLK_PERIOD)),)
PNR_CLK_PERIOD     := $(CLK_PERIOD)
PNR_CLK_PERIOD_SRC := CLK_PERIOD
else
PNR_CLK_PERIOD     := $(shell sed -n 's/^ *"clk_period_ps": *\([0-9.]*\).*/\1/p' $(PNR_NETLIST_PARAMS) 2>/dev/null)
PNR_CLK_PERIOD_SRC := netlist
ifeq ($(PNR_CLK_PERIOD),)
PNR_CLK_PERIOD     := $(CLK_PERIOD)
PNR_CLK_PERIOD_SRC := CLK_PERIOD
endif
endif
# Stop place and route after a stage, once it is saved (0_init ... 6_finish),
# e.g. 1_floorplan to look at the floorplan; empty runs them all
PNR_STOP_AFTER ?=
# Optimization trade-offs of place and route; empty keeps the technology
# flow's defaults
PNR_PREROUTE_SETUP_MARGIN    ?=
PNR_POSTROUTE_SETUP_MARGIN   ?=
PNR_HOLD_TARGET              ?=
PNR_PLACE_TIMING_EFFORT      ?=
PNR_PLACE_CONG_EFFORT        ?=
PNR_POSTROUTE_SETUP_RECOVERY ?=
# Everything a place-and-route run writes, one directory per run. Point it
# outside the checkout and several runs can share one clone.
PNR_RUN_DIR    ?= $(ASIC_BUILD)/pnr/$(TOP_DESIGN)_$(TIMESTAMP)

.PHONY: deps sram-inventory synth synth-elab synth-analyze synth-params pnr pnr-params spef

# The sources the flow reads: the submodule the design's Bender.yml refers to,
# and the Bender dependencies
deps:
	git -C $(CVA6_ROOT) submodule update --init core/cache_subsystem/hpdcache
	$(BENDER) -d $(CVA6_ROOT) checkout

# The SRAMs of the selected configuration (scripts/sram_inventory.py): every
# tc_sram and its shape, from the sources synthesis reads with the generic
# tc_sram, elaborated with slang (pyslang in the oseda container). Synthesis
# runs it first and checks that the netlist holds the same number of SRAMs.
OSEDA            ?= oseda -2025.12
SRAM_INVENTORY   ?= $(SYNTH_RUN_DIR)/sram_inventory.json
# The number of SRAMs in the inventory, read when a recipe expands it, so
# that it sees the inventory written earlier in the same make run
SRAM_COUNT        = $(shell python3 -c 'import json, sys; print(len(json.load(open(sys.argv[1]))["srams"]))' $(SRAM_INVENTORY) 2>/dev/null)
SLANG_ARGS       ?= --top $(TOP_DESIGN) -D SYNTHESIS --timescale 1ns/1ps \
                    --allow-use-before-declare --relax-enum-conversions \
                    --translate-off-format pragma,translate_off,translate_on \
                    --ignore-unknown-modules
sram-inventory:
	mkdir -p $(dir $(SRAM_INVENTORY))
	flist=$(basename $(SRAM_INVENTORY)).flist; \
	$(BENDER) -d $(CVA6_ROOT) script flist-plus $(BENDER_DEFINES) $(BENDER_TARGETS) \
	  -t tech_cells_generic_include_tc_sram -t tech_cells_generic_include_tc_clk > $$flist.$$$$ && \
	$(if $(CVA6_CONFIG_PKG),sed -i 's|^.*/core/include/$(CVA6_CONFIG)_config_pkg\.sv$$|$(abspath $(CVA6_CONFIG_PKG))|' $$flist.$$$$ && ,)\
	mv $$flist.$$$$ $$flist && \
	$(OSEDA) python3 $(ASIC_DIR)/scripts/sram_inventory.py --json $(SRAM_INVENTORY) -f $$flist $(SLANG_ARGS)

# The resolved parameters of a run, as JSON, for its record and for the runs
# that take its results: the synthesis parameters beside netlists/, and the
# place-and-route parameters with those of its netlist. ASIC_TECH_* come from
# the technology's section below.
comma := ,
empty :=
space := $(empty) $(empty)
GIT_REV   = $(shell git -C $(CVA6_ROOT) rev-parse HEAD 2>/dev/null)
GIT_DIRTY = $(if $(shell git -C $(CVA6_ROOT) status --porcelain --untracked-files=no 2>/dev/null),true,false)
json_list = [$(subst $(space),$(comma) ,$(patsubst %,"%",$(strip $(1))))]

synth-params:
	mkdir -p $(SYNTH_RUN_DIR)
	printf '{\n  "stage": "synth",\n  "commit": "%s",\n  "dirty": %s,\n  "tech": "%s",\n  "tech_commit": "%s",\n  "tech_dirty": %s,\n  "cva6_config": "%s",\n  "cva6_config_pkg": "%s",\n  "clk_period_ps": %s,\n  "synth_clk_period_ps": %s,\n  "synth_clk_period_source": "%s",\n  "synth_margin": %s,\n  "synth_margin_source": "%s",\n  "synth_stage": "%s",\n  "synth_hierarchy": "%s",\n  "synth_sb_no_cg": %s,\n  "mem_cuts": %s,\n  "sram_count": %s\n}\n' \
	  '$(GIT_REV)' '$(GIT_DIRTY)' '$(ASIC_TECH)' '$(ASIC_TECH_REV)' '$(ASIC_TECH_DIRTY)' '$(CVA6_CONFIG)' '$(CVA6_CONFIG_PKG)' \
	  '$(SYNTH_TARGET_PERIOD)' '$(SYNTH_CLK_PERIOD)' '$(SYNTH_CLK_PERIOD_SRC)' '$(SYNTH_MARGIN)' '$(SYNTH_MARGIN_SRC)' \
	  '$(SYNTH_STAGE)' '$(SYNTH_HIERARCHY)' '$(SYNTH_SB_NO_CG)' '$(call json_list,$(ASIC_TECH_MEM_CUTS))' '$(or $(SRAM_COUNT),null)' > $(SYNTH_RUN_DIR)/params.json

pnr-params:
	mkdir -p $(PNR_RUN_DIR)
	printf '{\n  "stage": "pnr",\n  "commit": "%s",\n  "dirty": %s,\n  "tech": "%s",\n  "tech_commit": "%s",\n  "tech_dirty": %s,\n  "pnr_clk_period_ps": %s,\n  "pnr_clk_period_source": "%s",\n  "pnr_floorplan": "%s",\n  "pnr_fp_w_um": %s,\n  "pnr_fp_h_um": %s,\n  "pnr_threads": "%s",\n  "pnr_stop_after": "%s",\n  "pnr_preroute_setup_margin": "%s",\n  "pnr_postroute_setup_margin": "%s",\n  "pnr_hold_target": "%s",\n  "pnr_place_timing_effort": "%s",\n  "pnr_place_cong_effort": "%s",\n  "pnr_postroute_setup_recovery": "%s",\n  "netlist": "%s",\n  "synthesis": %s\n}\n' \
	  '$(GIT_REV)' '$(GIT_DIRTY)' '$(ASIC_TECH)' '$(ASIC_TECH_REV)' '$(ASIC_TECH_DIRTY)' \
	  '$(PNR_CLK_PERIOD)' '$(PNR_CLK_PERIOD_SRC)' '$(PNR_FLOORPLAN)' '$(or $(ASIC_TECH_FP_W),null)' '$(or $(ASIC_TECH_FP_H),null)' '$(PNR_THREADS)' \
	  '$(PNR_STOP_AFTER)' '$(PNR_PREROUTE_SETUP_MARGIN)' '$(PNR_POSTROUTE_SETUP_MARGIN)' '$(PNR_HOLD_TARGET)' \
	  '$(PNR_PLACE_TIMING_EFFORT)' '$(PNR_PLACE_CONG_EFFORT)' '$(PNR_POSTROUTE_SETUP_RECOVERY)' '$(abspath $(PNR_NETLIST))' \
	  "$$(cat $(PNR_NETLIST_PARAMS) 2>/dev/null || echo null)" > $(PNR_RUN_DIR)/params.json

# The stages: the design side's checks and records, then the technology's
# flow (<tech>-synth, <tech>-pnr, <tech>-spef in its <tech>.mk)
synth: sram-inventory
	@echo "================================================================="
	@echo "RUNNING CVA6 SYNTHESIS FOR A CLOCK PERIOD OF $(SYNTH_TARGET_PERIOD) ps$(if $(filter elab,$(SYNTH_STAGE)), (ELABORATION ONLY))"
	@echo "SYNTHESIS PERIOD: $(SYNTH_CLK_PERIOD) ps ($(SYNTH_CLK_PERIOD_SRC))   MARGIN: $(SYNTH_MARGIN) ($(SYNTH_MARGIN_SRC))"
	$(if $(and $(synth_clk_period_given),$(synth_margin_given)),@echo "WARNING: SYNTH_CLK_PERIOD and SYNTH_MARGIN are both given; both apply")
	@echo "THREADS: $(SYNTH_THREADS)   HIERARCHY: $(SYNTH_HIERARCHY)   TECHNOLOGY: $(ASIC_TECH)"
	@echo "SRAM COUNT: $(SRAM_COUNT) (from $(SRAM_INVENTORY))"
	@echo "CONFIG: $(CVA6_CONFIG)$(if $(CVA6_CONFIG_PKG), with $(CVA6_CONFIG_PKG))"
	@echo "================================================================="
	@$(MAKE) --no-print-directory synth-params
	@$(MAKE) --no-print-directory $(ASIC_TECH)-synth

# Synthesis up to its checks: read, link, constraints, the SRAM checks and the
# timing checks, without compiling
synth-elab:
	@$(MAKE) --no-print-directory synth SYNTH_STAGE=elab

# The file list alone, to check what a synthesis run would read
synth-analyze:
	@$(MAKE) --no-print-directory $(ASIC_TECH)-analyze

pnr:
	@test -f $(PNR_NETLIST) || { \
	  echo "ERROR: no netlist at $(PNR_NETLIST)"; \
	  echo "       run 'make -C asic synth' first, or copy one in."; exit 1; }
	@echo "================================================================="
	@echo "RUNNING CVA6 PLACE AND ROUTE AT A CLOCK PERIOD OF $(PNR_CLK_PERIOD) ps ($(PNR_CLK_PERIOD_SRC))"
	@echo "FLOORPLAN: $(PNR_FLOORPLAN)   THREADS: $(PNR_THREADS)   TECHNOLOGY: $(ASIC_TECH)"
	@echo "================================================================="
	@$(MAKE) --no-print-directory pnr-params
	@$(MAKE) --no-print-directory $(ASIC_TECH)-pnr

# A target of its own: parasitics are large and only wanted for the operating
# points picked out of a sweep. It reads the saved design of the place-and-
# route run in PNR_RUN_DIR.
spef:
	@test -d $(PNR_RUN_DIR)/save/6_finish.enc.dat || { \
	  echo "ERROR: no saved design in $(PNR_RUN_DIR)/save"; \
	  echo "       parasitics need a completed 'make -C asic pnr' run."; exit 1; }
	@echo "================================================================="
	@echo "EXTRACTING PARASITICS OF $(TOP_DESIGN)_$(TIMESTAMP)   THREADS: $(PNR_THREADS)"
	@echo "================================================================="
	@$(MAKE) --no-print-directory $(ASIC_TECH)-spef

########
# GF22 #
########

# The GF22 flow is not open: it lives in cva6-gf22, cloned into asic/gf22 at
# GF22_COMMIT. gf22-init clones it, and does nothing to a clone that is already
# there; gf22-update moves a clone to GF22_COMMIT, unless it has local changes.
GF22_REMOTE ?= git@iis-git.ee.ethz.ch:ezelioli/cva6-gf22.git
GF22_COMMIT ?= a5c4b2cbecfc6092c6d3b207e213abadde792fd8
GF22_CLONE  := $(ASIC_DIR)/gf22

.PHONY: gf22-init gf22-update

gf22-init:
	@if [ -e $(GF22_CLONE)/.git ]; then \
	  echo "$(GF22_CLONE) is there; 'make -C asic gf22-update' moves it to $(GF22_COMMIT)"; \
	else \
	  git clone -q $(GF22_REMOTE) $(GF22_CLONE) && git -C $(GF22_CLONE) checkout -q $(GF22_COMMIT); \
	fi

gf22-update:
	@test -z "$$(git -C $(GF22_CLONE) status --porcelain --untracked-files=no)" || { \
	  echo "ERROR: $(GF22_CLONE) has local changes"; exit 1; }
	git -C $(GF22_CLONE) fetch -q origin
	git -C $(GF22_CLONE) checkout -q $(GF22_COMMIT)

ifneq ($(wildcard $(GF22_CLONE)/gf22.mk),)
include $(GF22_CLONE)/gf22.mk
ifeq ($(ASIC_TECH),gf22)
ASIC_TECH_REV      = $(GF22_REV)
ASIC_TECH_DIRTY    = $(GF22_DIRTY)
ASIC_TECH_MEM_CUTS = $(GF22_MEM_CUTS)
ASIC_TECH_FP_W     = $(GF22_FP_W)
ASIC_TECH_FP_H     = $(GF22_FP_H)
endif
ifneq ($(GF22_REV),$(GF22_COMMIT))
$(info NOTE: $(GF22_CLONE) is at $(GF22_REV), not at GF22_COMMIT $(GF22_COMMIT))
endif
else
gf22-%:
	@echo "ERROR: no GF22 flow in $(GF22_CLONE); run 'make -C asic gf22-init'" >&2; exit 1
endif
